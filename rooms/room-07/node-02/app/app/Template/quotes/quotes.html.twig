{% extends "base.html.twig" %}

{% block title %}{{ titre }}{% endblock %}

{% block content %}
<div class="row mt-5">
    <div class="col-md-12">
        <form method="get" class="row g-3">
            <div class="col-md-10">
                <input
                        class="form-control"
                        type="text"
                        name="search"
                        placeholder="Rechercher une citation"
                />
            </div>
            <div class="col-md-2">
                <input class="btn btn-primary" type="submit" value="Search" />
            </div>
        </form>
    </div>
</div>
<hr>
<div class="row">
    <div class="col-md-12">
        <table class="table table-striped table-hover table-condensed">
            <thead>
            <tr>
                <th scope="col">Id</th>
                <th scope="col">Epoque</th>
                <th scope="col">Annee</th>
                <th scope="col">Theme</th>
                <th scope="col">Auteur</th>
                <th scope="col">Citation</th>
            </tr>
            </thead>
            <tbody>
            {% for quote in quotes %}
                <tr>
                    <td>{{ quote.id }}</td>
                    <td>{{ quote.era }}</td>
                    <td>{{ quote.year }}</td>
                    <td>{{ quote.theme }}</td>
                    <td>{{ quote.author }}</td>
                    <td>{{ quote.text }}</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>

{% endblock %}